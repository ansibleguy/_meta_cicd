#!/usr/bin/env bash

set -euo pipefail

EXIT_CODE_SOFT='{{ tester.rc.soft_fail }}'
EXIT_CODE_FILE='{{ tester.rc.file }}'

test_script="$1"
test="$2"
repo_name="$3"
rc_file="${EXIT_CODE_FILE}${repo_name}_${test}.rc"

if [ -f "$rc_file" ]
then
  exit_code=$(cat "$rc_file")
else
  exit_code=1
fi

if [ "$exit_code" != '0' ] && [ "$exit_code" != "$EXIT_CODE_SOFT" ]
then
  $test_script "$repo_name" 'FAILED-ENVIRONMENT'
fi

